{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "screens": [
        "./src/screens"
      ],
      "screens/*": [
        "./src/screens/*"
      ],
      "benchmark": [
        "./src/benchmark"
      ],
      "benchmark/*": [
        "./src/benchmark/*"
      ],
      "forms": [
        "./src/forms"
      ],
      "forms/*": [
        "./src/forms/*"
      ],
      "api": [
        "./src/api"
      ],
      "api/*": [
        "./src/api/*"
      ],
      "components": [
        "./src/components"
      ],
      "components/*": [
        "./src/components/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
